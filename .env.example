# Bern_Financial_Data 环境配置模板
# 使用方法：复制本文件为 .env，然后填写你自己的密钥
#   cp .env.example .env   （Windows: copy .env.example .env）

# TuShare token（在 https://tushare.pro 注册获取，用于 tushare 数据源）
TUSHARE_TOKEN=

# TuShare API 地址（可选）。
# 默认用第三方代理 https://ts.gyzcloud.top/api（config/default.yaml 的 tushare.api_url），
# 可改为官方 https://api.waditu.com 或注释掉用 SDK 默认。
# TUSHARE_API_URL=https://ts.gyzcloud.top/api

# FRED API key（圣路易斯联储官方美国宏观数据）。
# 免费申请：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# FRED API 地址（可选，默认 https://api.stlouisfed.org）
# FRED_API_URL=https://api.stlouisfed.org

# 数据库路径（默认 data/berndata.db）
DB_PATH=data/berndata.db

# API 服务监听（本地）
API_HOST=127.0.0.1
API_PORT=8765

# 日志级别
LOG_LEVEL=INFO

# 查询缓存 TTL（秒）
CACHE_TTL_SECONDS=300

# deepseek API（可选，config/default.yaml 的 ai.provider=deepseek 时使用）
DEEPSEEK_API_KEY=

# API 服务访问 token（可选）
# 配置后，/api/v1/data/* 等接口需要带 X-API-Key: <token> 头或 ?token=<token>
# 留空 = 不启用鉴权（本地开发用）。建议设一个随机串。
API_TOKEN=
