# ---- 敏感配置 ----
# .env 含 TUSHARE_TOKEN / DEEPSEEK_API_KEY 等密钥，绝不入库
# 需要时复制 .env.example 为 .env 并填写自己的密钥
.env

# ---- 数据文件 ----
# SQLite 数据库（含 WAL 日志）——数据不入库
data/*.db
data/*.db-wal
data/*.db-shm
data/schedule_state.json
data/logs/
data/cache/
data/export/
# 导入表头记忆模板（运行期自动学习，可重建）
data/header_templates.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 测试缓存 ----
.pytest_cache/
.coverage
htmlcov/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 操作系统 ----
Thumbs.db
.DS_Store

# ---- 构建产物 / 导出 ----
dist/
build/
*.xlsx
*.pdf

# ---- 配置备份 ----
# catalog_io.save_catalog() 自动生成的 .bak 备份，不入库
*.bak
